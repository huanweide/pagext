{
  "name": "pagext",
  "version": "1.0.0",
  "description": "零依赖、纯 Node 单文件网页正文提取器：把任意网页/本地 HTML/stdin 变成干净 Markdown，自带 fetch，不靠 Readability/Turndown 黑盒。",
  "keywords": [
    "markdown",
    "html-to-markdown",
    "web-scraping",
    "readability",
    "zero-dependency",
    "cli",
    "llm",
    "ai-agent"
  ],
  "bin": {
    "pagext": "index.js"
  },
  "main": "index.js",
  "scripts": {
    "test": "node --test test.js",
    "smoke": "node scripts/smoke-cli.js",
    "verify": "npm test && npm run smoke"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanweide/pagext.git"
  }
}
